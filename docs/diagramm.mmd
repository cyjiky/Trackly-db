erDiagram
  USERS ||--o{ HABITS : "creates"
  USERS |o--o{ TASKS : "asigned_to"
  USERS ||--o{ TASKS : "creates"
  USERS ||--o{ WORKSPACES : "owns"
  USERS |o--o{ CATEGORIES : "owns"
  USERS ||--o{ WORKSPACE_MEMBERS : "belongs_to"

  WORKSPACES ||--o{ WORKSPACE_MEMBERS : "has"
  WORKSPACES |o--o{ TASKS : "contains"
  WORKSPACES |o--o{ CATEGORIES : "contains"

  HABITS ||--o{ HABIT_COMPLETIONS : "tracks"

  HABITS ||--o{ HABIT_CATEGORIES : "categorized_by"
  CATEGORIES ||--o{ HABIT_CATEGORIES : "applies_to"

  TASKS ||--o{ TASK_CATEGORIES : "categorized_by"
  CATEGORIES ||--o{ TASK_CATEGORIES : "applies_to"

  USERS {
    int id PK
    string name
    string nickname 
    string phone_number 
    string password
    string email
    string timezone
    timestamp created_at
  }

  HABITS {
    int id PK
    string name
    text description "Nullable"
    int creator_id FK
    string timezone
    string status
    date start_date
    date end_date
    timestamp created_at
    timestamp deleted_at "Nullable"
  }

  HABIT_COMPLETIONS {
    int id PK
    int habit_id FK
    timestamp completed_at
    string status
    text note "Nullable"
  }

  TASKS {
    int id PK
    string name
    text description "Nullable"
    string status
    int priority "Nullable"
    int creator_id FK
    int assignee_id FK "Nullable"
    int workspace_id FK "Nullable"
    timestamp created_at
    timestamp deadline "Nullable"
    timestamp deleted_at "Nullable"
    timestamp updated_at
  }

  CATEGORIES {
    int id PK
    string name
    string color
    int owner_id FK
    int workspace_id FK "Nullable"
    timestamp created_at
    timestamp deleted_at "Nullable"
  }
  
  WORKSPACES {
    int id PK
    string name
    text description "Nullable"
    int owner_id FK
    timestamp created_at
  }

  WORKSPACE_MEMBERS {
    int user_id FK, PK
    int workspace_id FK, PK
    string role
    timestamp joined_at
  }

  TASK_CATEGORIES {
    int task_id FK, PK
    int category_id FK, PK
  }

  HABIT_CATEGORIES {
    int habit_id FK, PK
    int category_id FK, PK
  }
